# Public URL of the site (no trailing slash). Used for share links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API. SERVICE ROLE KEY IS SECRET: server only, never NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. Protects the cleanup endpoint.
CRON_SECRET=change-me-to-a-long-random-string
